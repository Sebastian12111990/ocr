PUERTO=6000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ocr
POSTGRES_PASSWORD=ocr
POSTGRES_DB=ocr

URL_SERVICIO_CV=http://localhost:8000

# Raíz de las imágenes crudas del dataset — debe ser la MISMA ruta que YOLO_IMAGENES_DIR
# en el ".env" de la raíz del repo (una la lee la API directo del disco, la otra la monta Docker).
RUTA_IMAGENES_DATASET=D:\img_dataset

# Dispositivo que usa detectar.py dentro del contenedor yolo: "0" (primera GPU NVIDIA) o "cpu"
# si esta PC no tiene GPU o el modelo no entra en su VRAM.
YOLO_DEVICE=0

# Carpeta para el export efímero de entrenamiento — debe ser la MISMA ruta que YOLO_EXPORTS_DIR
# en el ".env" de la raíz del repo (esta la escribe la API directo por hardlinks, esa la monta
# Docker dentro del contenedor donde corre Ultralytics).
RUTA_EXPORTS_YOLO=D:\ocr_entrenamientos
