# Variables usadas por compose.yml (docker compose up). Copiar a ".env" y
# ajustar las rutas D:\... a donde esté el dataset en ESTA pc.

# Carpeta con las imágenes originales del sondeo YOLO (solo lectura dentro del contenedor)
YOLO_IMAGENES_DIR=D:\imagenes - copia

# Carpeta del dataset de patentes (dataset/, sin_vehiculo/, sin_deteccion/, labels/)
# Debe ser la MISMA ruta que RUTA_DATASET_YOLO en apps/api/.env.development —
# una la lee el contenedor de YOLO, la otra la lee la API de Node directo del disco.
YOLO_DATASET_DIR=D:\patentes Data Set

# Postgres (coinciden con los defaults de apps/api/.env.example)
POSTGRES_USER=ocr
POSTGRES_PASSWORD=ocr
POSTGRES_DB=ocr
POSTGRES_PORT=5432
