# Variables usadas por compose.yml (docker compose up). Copiar a ".env" y
# ajustar las rutas D:\... a donde esté el dataset en ESTA pc.

# Carpeta con las imágenes crudas del dataset (solo lectura dentro del contenedor).
# Debe ser la MISMA ruta que RUTA_IMAGENES_DATASET en apps/api/.env.development —
# una la monta Docker dentro del contenedor, la otra la lee la API de Node directo del disco.
YOLO_IMAGENES_DIR=D:\img_dataset

# Postgres (coinciden con los defaults de apps/api/.env.example)
POSTGRES_USER=ocr
POSTGRES_PASSWORD=ocr
POSTGRES_DB=ocr
POSTGRES_PORT=5432
